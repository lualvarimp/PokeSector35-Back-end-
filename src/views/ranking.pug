extends layout

block content
  .ranking-container
    //- Encabezado
    .ranking-header
      h1.ranking-title Ranking Global
      p.ranking-subtitle Mejores jugadores por dificultad

    //- Filtros
    .ranking-filters
      .filter-group
        label(for='difficultyFilter') Filtrar por Dificultad:
        select#difficultyFilter.filter-select
          option(value='todos') Todas
          option(value='facil') Fácil
          option(value='normal') Normal
          option(value='dificil') Difícil
          option(value='infernal') Infernal

    //- Tabla de ranking
    .table-wrapper
      table.ranking-table
        thead
          tr
            th
              span(data-sort-state='none') Pos.
              .sort-icon ↑
              .sort-icon ↓
              .sort-icon ↕
            th
              span(data-sort-state='none') Usuario
              .sort-icon ↑
              .sort-icon ↓
              .sort-icon ↕
            th
              span(data-sort-state='none') Capt.
              .sort-icon ↑
              .sort-icon ↓
              .sort-icon ↕
            th
              span(data-sort-state='none') Esc.
              .sort-icon ↑
              .sort-icon ↓
              .sort-icon ↕
            th
              span(data-sort-state='none') % Capt.
              .sort-icon ↑
              .sort-icon ↓
              .sort-icon ↕
            th
              span(data-sort-state='none') Nivel
              .sort-icon ↑
              .sort-icon ↓
              .sort-icon ↕
            th
              span(data-sort-state='none') Fecha
              .sort-icon ↑
              .sort-icon ↓
              .sort-icon ↕
            th Acciones

        tbody#rankingTableBody
          tr
            td(colspan='8').loading Cargando ranking...

    //- Paginación
    .ranking-pagination
      #pageInfo Página 1 de 1
      .pagination-controls
        button#prevBtn.pagination-btn(onclick='previousPage()' disabled) ‹ Anterior
        button#nextBtn.pagination-btn(onclick='nextPage()') Siguiente ›

block scripts
  script(src='/js/multiColumnSort.js')
  script(src='/js/ranking.js')
