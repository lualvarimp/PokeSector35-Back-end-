extends layout

block content
  .users-container
    //- Header
    .users-header
      h1.users-title Gestión de Usuarios

    //- Filtros
    .users-filters
      .filter-group
        label(for='roleFilter') Filtrar por rol:
        select#roleFilter.filter-select
          option(value='all') Todos
          option(value='user') Usuario
          option(value='admin') Admin

      .filter-group
        label(for='letterFilter') Filtrar por letra:
        select#letterFilter.filter-select
          option(value='all') Todas
          option(value='A') A
          option(value='B') B
          option(value='C') C
          option(value='D') D
          option(value='E') E
          option(value='F') F
          option(value='G') G
          option(value='H') H
          option(value='I') I
          option(value='J') J
          option(value='K') K
          option(value='L') L
          option(value='M') M
          option(value='N') N
          option(value='O') O
          option(value='P') P
          option(value='Q') Q
          option(value='R') R
          option(value='S') S
          option(value='T') T
          option(value='U') U
          option(value='V') V
          option(value='W') W
          option(value='X') X
          option(value='Y') Y
          option(value='Z') Z

    //- Tabla de usuarios
    .table-wrapper
      table.users-table
        thead
          tr
            th
              span(data-sort-state='none') ID
              .sort-icon ↑
              .sort-icon ↓
              .sort-icon ↕
            th
              span(data-sort-state='none') Usuario
              .sort-icon ↑
              .sort-icon ↓
              .sort-icon ↕
            th Rol
            th Creado
            th Acciones

        tbody#usersTableBody
          tr
            td(colspan='5').loading Cargando usuarios...

    //- Paginación
    .users-pagination
      #pageInfo Página 1 de 1
      .pagination-controls
        button#prevBtn.pagination-btn(onclick='previousPage()' disabled) ‹ Anterior
        button#nextBtn.pagination-btn(onclick='nextPage()') Siguiente ›

block scripts
  script(src='/js/multiColumnSort.js')
  script(src='/js/users.js')
